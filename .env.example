# ---------------------------------------------------------------------------
# Configuration Supabase (côté client)
# ---------------------------------------------------------------------------
# Copiez ce fichier en `.env.local` puis renseignez vos valeurs.
# SEULE la clé "anon" (publique) doit être exposée au frontend.
# Ne JAMAIS mettre la clé "service_role" ici — elle contourne la RLS.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ---------------------------------------------------------------------------
# Configuration de l'événement (valeurs de repli / bootstrap)
# ---------------------------------------------------------------------------
# Ces valeurs servent de repli tant que l'événement n'est pas encore stocké
# en base (table `events`). Les prix restent NON fiables côté frontend :
# ils sont ré-évalués côté serveur/base au Sprint 2 (voir BUSINESS_RULES.md).
VITE_EVENT_NAME="Cérémonie d'accueil (à confirmer)"
VITE_EVENT_DATE="2026-10-01"
VITE_EVENT_LOCATION="Lieu à confirmer"
VITE_ALUMNI_PRICE_CENTS="1000"
VITE_OTHER_PRICE_CENTS="1500"
VITE_CURRENCY="EUR"
