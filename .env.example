# ---------------------------------------------------------------------------
# Configuration Supabase (côté client)
# ---------------------------------------------------------------------------
# Copiez ce fichier en `.env.local` puis renseignez vos valeurs.
# SEULE la clé "anon" (publique) doit être exposée au frontend.
# Ne JAMAIS mettre la clé "service_role" ici — elle contourne la RLS.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ---------------------------------------------------------------------------
# Configuration de l'événement (valeurs de repli / bootstrap)
# ---------------------------------------------------------------------------
# Ces valeurs servent de repli tant que l'événement n'est pas encore stocké
# en base (table `events`). Les prix restent NON fiables côté frontend :
# ils sont ré-évalués côté serveur/base au Sprint 2 (voir BUSINESS_RULES.md).
VITE_EVENT_NAME="Cérémonie d'accueil"
VITE_EVENT_DATE="2026-10-03"
VITE_EVENT_LOCATION="31 rue de Vendée, 29200 Brest"
VITE_EVENT_START_TIME="19:00"
VITE_ALUMNI_PRICE_CENTS="2500"
VITE_OTHER_PRICE_CENTS="2500"
VITE_CURRENCY="EUR"

# ---------------------------------------------------------------------------
# Paiement Wero (instructions affichées à l'utilisateur — non sensibles)
# ---------------------------------------------------------------------------
# Le paiement Wero V1 = déclaration utilisateur + confirmation administrative.
# Aucune clé secrète ici ; uniquement des informations d'affichage.
VITE_WERO_BENEFICIARY="Nom du bénéficiaire Wero"
VITE_WERO_HANDLE="+33 6 00 00 00 00"
VITE_WERO_INSTRUCTIONS="Payez via Wero au bénéficiaire indiqué en précisant votre référence, puis confirmez."
